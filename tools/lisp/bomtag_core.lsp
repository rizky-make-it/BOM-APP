;;; BOMTAG v1 - Tala BOM-APP. Commands: BOMTAG (tag a component), BOMCHECK (audit tags), BOMEXPORT (JSON for BOM-APP).
;;; Tag = boxed number + leader (layer BOM-NO). The data lives in XDATA (app TALA_BOM) on the number text, so drawing and schedule cannot disagree.
;;; Works in any drawing plane: BOMTAG aligns the UCS to the current view (UCS V) and restores it.
(setq *bt-app* "TALA_BOM" *bt-layer* "BOM-NO" *bt-last* (list "" "A" 1 18.0))
(defun bt-regapp () (if (not (tblsearch "APPID" *bt-app*)) (regapp *bt-app*)))
(defun bt-lay ()
  (if (not (tblsearch "LAYER" *bt-layer*))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 *bt-layer*) '(70 . 0) '(62 . 5) '(6 . "Continuous")))))
(defun bt-name (no / a) (setq a (assoc no *bt-parts*)) (if a (cadr a) ""))
(defun bt-mat-ok (c) (or (member c *bt-mats*) (and (> (strlen c) 3) (= (substr c 1 3) "MT-"))))
(defun bt-xd (e / d x) (setq d (entget e (list *bt-app*)) x (assoc -3 d)) (if x (mapcar 'cdr (cdr (cadr x)))))
(defun bt-nrm () (trans '(0.0 0.0 1.0) 1 0 T))
(defun bt-ln (a b) (entmake (list '(0 . "LINE") (cons 8 *bt-layer*) (cons 10 (trans a 1 0)) (cons 11 (trans b 1 0)))))
(defun bt-js (s / o i c k) (setq o "" i 1)
  (while (<= i (strlen s)) (setq c (substr s i 1) k (ascii c))
    (cond ((= k 34) (setq o (strcat o "'"))) ((= k 92) (setq o (strcat o "/"))) ((< k 32) (setq o (strcat o " "))) (t (setq o (strcat o c))))
    (setq i (1+ i))) o)
(defun bt-tags (/ e r f) (setq e (entnext) r '())
  (while e (setq f (bt-xd e)) (if (and f (>= (length f) 12)) (setq r (cons f r))) (setq e (entnext e))) (reverse r))
(defun bt-next-row (/ mx f) (setq mx 0) (foreach f (bt-tags) (setq mx (max mx (atoi (car f))))) (1+ mx))
(defun bt-spec (no l w tt code) (strcat no "|" (rtos l 2 1) "|" (rtos w 2 1) "|" (rtos tt 2 1) "|" code))
(defun bt-find (spec / hit f) (foreach f (bt-tags) (if (and (not hit) (= spec (bt-spec (nth 1 f) (atof (nth 3 f)) (atof (nth 4 f)) (atof (nth 5 f)) (nth 7 f)))) (setq hit f))) hit)
;; core (no user input): tip/box are UCS points. Returns STATED or CHECK.
(defun bt-add (row no l w tt qty code tip box h / hs cx cy cz n nm st x1 x2 y1 y2 ex ey tw fld)
  (bt-regapp) (bt-lay)
  (setq hs (* 1.1 h) cx (car box) cy (cadr box) cz (if (caddr box) (caddr box) 0.0) n (bt-nrm) nm (bt-name no)
        st (if (and (/= nm "") (bt-mat-ok code) (> l 0) (> w 0)) "STATED" "CHECK")
        x1 (- cx hs) x2 (+ cx hs) y1 (- cy hs) y2 (+ cy hs) tip (list (car tip) (cadr tip) (if (caddr tip) (caddr tip) 0.0)))
  (if (>= (abs (- (car tip) cx)) (abs (- (cadr tip) cy)))
    (setq ex (if (> (car tip) cx) x2 x1) ey cy)
    (setq ex cx ey (if (> (cadr tip) cy) y2 y1)))
  (bt-ln (list x1 y1 cz) (list x2 y1 cz)) (bt-ln (list x2 y1 cz) (list x2 y2 cz)) (bt-ln (list x2 y2 cz) (list x1 y2 cz)) (bt-ln (list x1 y2 cz) (list x1 y1 cz))
  (bt-ln tip (list ex ey cz))
  (setq tw (trans tip 1 0)
        fld (list (itoa row) no nm (rtos l 2 2) (rtos w 2 2) (rtos tt 2 2) (itoa qty) code st (rtos (car tw) 2 3) (rtos (cadr tw) 2 3) (rtos (caddr tw) 2 3)))
  (entmake (list '(0 . "TEXT") (cons 8 *bt-layer*) (cons 10 (trans (list cx cy cz) 1 n)) (cons 40 (* 0.9 h)) (cons 1 (itoa row)) '(72 . 1) '(73 . 2)
                 (cons 11 (trans (list cx cy cz) 1 n)) (cons 210 n) (list -3 (cons *bt-app* (mapcar '(lambda (s) (cons 1000 s)) fld)))))
  st)
(defun bt-export (path / fl first f tg)
  (setq fl (open path "w") tg (bt-tags) first T)
  (write-line "{\"tags\":[" fl)
  (foreach f tg
    (write-line (strcat (if first "" ",") "{\"row\":" (nth 0 f) ",\"part_no\":\"" (bt-js (nth 1 f)) "\",\"name\":\"" (bt-js (nth 2 f)) "\",\"l\":" (nth 3 f) ",\"w\":" (nth 4 f) ",\"t\":" (nth 5 f)
                        ",\"qty\":" (nth 6 f) ",\"code\":\"" (bt-js (nth 7 f)) "\",\"status\":\"" (nth 8 f) "\",\"tip\":[" (nth 9 f) "," (nth 10 f) "," (nth 11 f) "]}") fl)
    (setq first nil))
  (write-line "]}" fl) (close fl) (length tg))
(defun bt-check (/ tg msgs seen f r sp old m)
  (setq tg (bt-tags) msgs '() seen '())
  (foreach f tg
    (setq r (car f) sp (bt-spec (nth 1 f) (atof (nth 3 f)) (atof (nth 4 f)) (atof (nth 5 f)) (nth 7 f)))
    (if (= (bt-name (nth 1 f)) "") (setq msgs (cons (strcat "tag " r ": nomor part '" (nth 1 f) "' tidak ada di Part Master v3") msgs)))
    (if (not (bt-mat-ok (nth 7 f))) (setq msgs (cons (strcat "tag " r ": kode bahan '" (nth 7 f) "' tidak dikenal") msgs)))
    (if (or (<= (atof (nth 3 f)) 0) (<= (atof (nth 4 f)) 0)) (setq msgs (cons (strcat "tag " r ": ukuran L/W belum terisi") msgs)))
    (setq old (assoc r seen))
    (if (and old (/= (cdr old) sp)) (setq msgs (cons (strcat "nomor " r " dipakai untuk 2 spesifikasi berbeda") msgs)))
    (if (not old) (setq seen (cons (cons r sp) seen))))
  (princ (strcat "\nBOMCHECK: " (itoa (length tg)) " tag, " (itoa (length seen)) " baris unik, " (itoa (length msgs)) " masalah"))
  (foreach m (reverse msgs) (princ (strcat "\n  - " m)))
  (length msgs))
;; ---- interactive commands (need a person at the keyboard; NOT exercised by the headless test)
(defun bt-ask-part (/ s ok p)
  (setq ok nil)
  (while (not ok)
    (setq s (getstring (strcat "\nNo part Part Master v3 (3 digit), ? = daftar <" (car *bt-last*) ">: ")))
    (cond ((= s "") (setq s (car *bt-last*)) (setq ok (/= (bt-name s) "")) (if (not ok) (princ "\n  isi nomor part dulu")))
          ((= s "?") (foreach p *bt-parts* (princ (strcat "\n  " (car p) "  " (cadr p)))))
          ((/= (bt-name s) "") (setq ok T))
          (T (princ "\n  nomor tidak ada di Part Master v3"))))
  s)
(defun c:BOMTAG (/ h pt bx no code qty l w tt hit row s1 s2 e0 d xs ys a)
  (bt-regapp) (bt-lay)
  (setq h (* 0.02 (getvar "VIEWSIZE")))
  (command "_.UCS" "_V")
  (while (setq pt (getpoint "\nKlik di dalam komponen (Enter = selesai): "))
    (setq l 0.0 w 0.0 e0 (entlast))
    (command "_.-BOUNDARY" pt "")
    (if (and (entlast) (not (equal (entlast) e0)))
      (progn (setq d (entget (entlast)) xs '() ys '())
             (foreach a d (if (= (car a) 10) (setq xs (cons (cadr a) xs) ys (cons (caddr a) ys))))
             (if xs (setq l (max (- (apply 'max xs) (apply 'min xs)) (- (apply 'max ys) (apply 'min ys))) w (min (- (apply 'max xs) (apply 'min xs)) (- (apply 'max ys) (apply 'min ys)))))
             (entdel (entlast))))
    (princ (strcat "\nTerukur: " (rtos l 2 1) " x " (rtos w 2 1)))
    (setq no (bt-ask-part))
    (princ (strcat "  -> " (bt-name no)))
    (setq code (getstring (strcat "\nKode bahan (A, A1, B-18-1X, C-18-1X, MT-20x20, ...) <" (cadr *bt-last*) ">: ")))
    (if (= code "") (setq code (cadr *bt-last*)))
    (setq s1 (getreal (strcat "\nPanjang <" (rtos l 2 1) ">: "))) (if s1 (setq l s1))
    (setq s2 (getreal (strcat "\nLebar <" (rtos w 2 1) ">: "))) (if s2 (setq w s2))
    (setq tt (getreal (strcat "\nTebal <" (rtos (nth 3 *bt-last*) 2 1) ">: "))) (if (not tt) (setq tt (nth 3 *bt-last*)))
    (setq hit (bt-find (bt-spec no l w tt code)))
    (if hit
      (setq row (atoi (car hit)) qty (atoi (nth 6 hit)))
      (progn (setq row (bt-next-row)) (setq qty (getint (strcat "\nJumlah total part ini <" (itoa (nth 2 *bt-last*)) ">: "))) (if (not qty) (setq qty (nth 2 *bt-last*)))))
    (setq bx (getpoint pt "\nTitik kotak nomor: "))
    (if bx (princ (strcat "\nTag " (itoa row) ": " (bt-add row no l w tt qty code pt bx h))))
    (setq *bt-last* (list no code qty tt)))
  (command "_.UCS" "_P")
  (princ))
(defun c:BOMCHECK () (bt-check) (princ))
(defun c:BOMEXPORT (/ p)
  (setq p (strcat (getvar "DWGPREFIX") (vl-filename-base (getvar "DWGNAME")) "_bomtag.json"))
  (princ (strcat "\n" (itoa (bt-export p)) " tag ditulis ke " p)) (bt-check) (princ))
(princ "\nBOMTAG dimuat: BOMTAG, BOMCHECK, BOMEXPORT")
(princ)
